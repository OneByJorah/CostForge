# =============================================================================
# CostForge Frontend — nginx serving pre-built SPA
# Tag convention: jorahone/costforge-frontend:latest
# =============================================================================
FROM nginx:alpine

# Copy pre-built static files
COPY ./frontend/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Run as an unprivileged user: nginx listens on 8080 instead of 80 so the
# container does not need root (trivy DS-0002). The nginx:alpine image already
# ships an unprivileged `nginx` user (uid 101).
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD wget --spider -q http://127.0.0.1:8080/ || exit 1

LABEL org.opencontainers.image.title="CostForge Frontend" \
      org.opencontainers.image.description="nginx serving CostForge SPA" \
      org.opencontainers.image.vendor="JorahOne" \
      org.opencontainers.image.version="1.0.0"

CMD ["nginx", "-g", "daemon off;"]
